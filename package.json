{
	"name": "mcp-glassbox",
	"version": "0.0.0",
	"description": "A transparent, trustworthy bridge between MCP clients and web pages (spec: docs/spec.md)",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=20"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"bin": {
		"glassbox": "dist/cli.js"
	},
	"scripts": {
		"build": "rm -rf dist && tsup",
		"postbuild": "chmod +x dist/cli.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"conformance": "vitest run test/conformance.test.ts",
		"check": "biome check .",
		"selfcheck": "node scripts/selfcheck.mjs",
		"setup": "node scripts/setup.mjs"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.30.1",
		"ws": "8.22.0",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/node": "22.20.4",
		"@types/ws": "8.18.1",
		"fast-check": "4.10.2",
		"qrcode": "1.5.4",
		"tsup": "8.5.1",
		"typescript": "5.9.3",
		"vitest": "5.0.2"
	}
}
